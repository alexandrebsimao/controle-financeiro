# ==============================================================================
# Controle Financeiro - Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Configurações Gerais do Rails
# ------------------------------------------------------------------------------
RAILS_ENV=development
PORT=3000
APP_HOST=localhost:3000
RAILS_MAX_THREADS=5

# Chave secreta da aplicação (essencial em produção)
# Gere uma com: bundle exec rails secret
SECRET_KEY_BASE=sua_secret_key_base_aqui

# ------------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=finances_development

# Alternativamente, você pode definir a URL completa de conexão:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/finances_development

# ------------------------------------------------------------------------------
# Redis & Background Jobs (Sidekiq)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Credenciais de acesso ao painel do Sidekiq (/sidekiq)
SIDEKIQ_USERNAME=admin
SIDEKIQ_PASSWORD=sua_senha_segura_aqui

# ------------------------------------------------------------------------------
# Envio de E-mails (Resend)
# ------------------------------------------------------------------------------
# Obtenha sua chave em: https://resend.com/api-keys
RESEND_API_KEY=re_seu_token_resend_aqui
MAILER_DEFAULT_FROM=noreply@seu-dominio.com

# ------------------------------------------------------------------------------
# Inteligência Artificial (Consultoria Financeira & Insights)
# ------------------------------------------------------------------------------
# Provedor padrão: "groq" ou "gemini"
AI_PROVIDER=groq

# Provedor: Groq (Llama 3 / Mixtral)
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Provedor: Google Gemini
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=AIza_sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Servidor MCP (Model Context Protocol)
# ------------------------------------------------------------------------------
# Token para autenticar clientes de IA (ex: Claude Desktop, Antigravity, Cursor)
MCP_AUTH_TOKEN=gere_um_token_longo_e_aleatorio_aqui
