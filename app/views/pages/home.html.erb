<div class="min-h-screen bg-slate-50 flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
  <div class="max-w-md w-full app-card p-8">
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-700 to-indigo-600 text-white font-extrabold text-2xl flex items-center justify-center mx-auto mb-3 shadow-lg shadow-brand-500/25">
        ⚡
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Finances</h1>
      <p class="text-xs text-slate-500 mt-1">Gestão financeira inteligente, simples e automatizada com IA</p>
    </div>

    <div class="space-y-3">
      <%= link_to "Entrar na Conta", new_user_session_path, class: "w-full btn-primary py-3 text-sm font-bold shadow-md hover:shadow-lg transition" %>
      <%= link_to "Criar Nova Conta", new_user_registration_path, class: "w-full btn-secondary py-3 text-sm font-bold transition" %>
    </div>

    <div class="mt-8 pt-6 border-t border-slate-100">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Recursos Disponíveis</h3>
      <ul class="space-y-2.5 text-xs text-slate-600">
        <li class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Controle de contas bancárias e saldos em tempo real</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Gestão completa de cartões de crédito e faturas</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Importação de extratos via CSV com categorização por IA</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Consultoria financeira automatizada com Groq & Gemini</span>
        </li>
      </ul>
    </div>
  </div>
</div>
