<h1>Movimentações a Vencer</h1>

<p>Olá <%= @user.name %>,</p>

<p>Segue abaixo um resumo das movimentações a vencer de acordo com a data:</p>

<% if @due_transactions[:overdue].any? %>
  <h2 style="color: #dc2626;">Vencidas</h2>
  <table border="1" cellpadding="10" style="width: 100%; border-collapse: collapse;">
    <thead style="background-color: #fee2e2;">
      <tr>
        <th>Título</th>
        <th>Valor</th>
        <th>Data de Vencimento</th>
        <th>Categoria</th>
      </tr>
    </thead>
    <tbody>
      <% @due_transactions[:overdue].each do |transaction| %>
        <tr>
          <td><%= transaction.title %></td>
          <td><%= transaction.formatted_amount %></td>
          <td><%= l(transaction.due_date, format: :long) %></td>
          <td><%= transaction.category&.name || "Sem categoria" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @due_transactions[:due_today].any? %>
  <h2 style="color: #f59e0b; margin-top: 20px;">Vence Hoje</h2>
