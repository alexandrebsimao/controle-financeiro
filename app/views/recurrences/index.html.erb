<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Movimentações Recorrentes</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Automatize contas fixas como salários, assinaturas e aluguel</p>
    </div>
    <%= link_to new_recurrence_path, class: "btn-primary btn-md gap-1.5 self-start sm:self-auto" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      <span>Nova Recorrência</span>
    <% end %>
  </div>

  <div class="app-card overflow-hidden">
    <% if @recurrences.any? %>
      <div class="overflow-x-auto">
        <table class="app-table">
          <thead>
            <tr>
              <th>Descrição & Conta</th>
              <th>Tipo</th>
              <th>Frequência</th>
              <th>Valor</th>
              <th>Progresso</th>
              <th>Status</th>
              <th class="text-right w-16">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @recurrences.each do |recurrence| %>
              <tr>
                <td>
                  <div class="font-bold text-slate-900">
                    <%= link_to recurrence.title, recurrence, class: "hover:text-brand-600 transition" %>
                  </div>
                  <div class="text-xs text-slate-400"><%= recurrence.bank_account.name %></div>
                </td>
                <td>
                  <% if recurrence.transaction_type == 'income' %>
                    <span class="badge badge-success">Entrada</span>
                  <% else %>
                    <span class="badge badge-danger">Saída</span>
                  <% end %>
                </td>
                <td class="text-xs text-slate-600 font-medium">
                  <%= "A cada #{recurrence.interval} " unless recurrence.interval == 1 %><%= recurrence.frequency.titleize %>
                </td>
                <td class="font-bold whitespace-nowrap <%= recurrence.transaction_type == 'income' ? 'text-emerald-600' : 'text-rose-600' %>">
                  <%= recurrence.transaction_type == 'income' ? '+' : '-' %><%= number_to_currency(recurrence.amount, unit: "R$", separator: ",", delimiter: ".") %>
                </td>
                <td class="text-xs text-slate-500">
                  <% if recurrence.total_occurrences %>
                    <%= "#{recurrence.occurrences_generated} de #{recurrence.total_occurrences}" %>
                  <% elsif recurrence.end_date %>
                    <%= "#{recurrence.occurrences_generated} (até #{recurrence.end_date.strftime('%d/%m/%Y')})" %>
                  <% else %>
                    <%= "#{recurrence.occurrences_generated} (contínua)" %>
                  <% end %>
                </td>
                <td>
                  <% if recurrence.active? %>
                    <span class="badge badge-success">Ativa</span>
                  <% else %>
                    <span class="badge badge-neutral">Inativa</span>
                  <% end %>
                </td>
                <td class="text-right">
                  <div class="relative inline-block text-left" data-controller="dropdown">
                    <button type="button" class="action-menu-btn" data-dropdown-target="button" data-action="click->dropdown#toggle" title="Ações" aria-label="Menu de ações">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                      </svg>
                    </button>

                    <div data-dropdown-target="menu" class="hidden action-menu-dropdown">
                      <%= link_to recurrence, class: "action-menu-item" do %>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <span>Ver detalhes</span>
                      <% end %>
                      <%= link_to edit_recurrence_path(recurrence), class: "action-menu-item" do %>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        <span>Editar</span>
                      <% end %>
                      <% if recurrence.active? %>
                        <%= button_to deactivate_recurrence_path(recurrence), method: :patch, class: "action-menu-item action-menu-item-warning" do %>
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                          <span>Pausar</span>
                        <% end %>
                      <% else %>
                        <%= button_to activate_recurrence_path(recurrence), method: :patch, class: "action-menu-item action-menu-item-success" do %>
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                          <span>Ativar</span>
                        <% end %>
                      <% end %>
                      <div class="action-menu-divider"></div>
                      <%= button_to recurrence, method: :delete, data: { turbo_confirm: "Tem certeza que deseja apagar esta regra de recorrência?" }, class: "action-menu-item action-menu-item-danger" do %>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        <span>Apagar</span>
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-16 px-4">
        <span class="text-4xl block mb-2">🔁</span>
        <h3 class="text-base font-bold text-slate-800">Nenhuma movimentação recorrente</h3>
        <p class="text-xs text-slate-400 mt-1 mb-5 max-w-sm mx-auto">
          Crie recorrências para gerar automaticamente lançamentos mensais ou periódicos.
        </p>
        <%= link_to "Criar Primeira Recorrência", new_recurrence_path, class: "btn-primary btn-md text-xs" %>
      </div>
    <% end %>
  </div>
</div>
