<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Editar Movimentação Recorrente</h1>
      <p class="text-xs text-slate-500 mt-0.5">Atualize regras de recorrência, datas ou valor</p>
    </div>
    <%= link_to "← Voltar", recurrences_path, class: "text-xs font-semibold text-slate-500 hover:text-slate-800" %>
  </div>

  <div class="app-card p-6 sm:p-8">
    <%= form_with model: @recurrence, local: true, class: "space-y-6" do |f| %>
      <% if @recurrence.errors.any? %>
        <div class="rounded-2xl bg-rose-50 border border-rose-200/80 p-4">
          <h3 class="text-xs font-bold text-rose-800 uppercase tracking-wider"><%= pluralize(@recurrence.errors.count, "erro") %> encontrado(s):</h3>
          <ul class="mt-2 list-disc list-inside text-xs text-rose-700 space-y-0.5">
            <% @recurrence.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :title, "Descrição da Recorrência", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :title, required: true, class: "form-input-custom" %>
        </div>

        <div>
          <%= f.label :transaction_type, "Tipo de Movimentação", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.select :transaction_type, [["Entrada (Receita)", "income"], ["Saída (Despesa)", "expense"]], {}, required: true, class: "form-select-custom" %>
        </div>

        <div>
          <%= f.label :bank_account_id, "Conta Bancária", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.select :bank_account_id, @bank_accounts.map { |ba| [ba.name, ba.id] }, {}, required: true, class: "form-select-custom" %>
        </div>

        <div>
          <%= f.label :category_id, "Categoria", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.select :category_id, @categories.map { |c| [c.full_name, c.id] }, { prompt: "Selecione uma categoria" }, class: "form-select-custom" %>
        </div>

        <div>
          <%= f.label :amount, "Valor Previsto (R$)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :amount, step: 0.01, required: true, class: "form-input-custom font-semibold text-slate-900" %>
        </div>

        <div>
          <%= f.label :payment_method, "Forma de Pagamento", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.select :payment_method, Recurrence::PAYMENT_METHODS.invert, { prompt: "Selecione" }, class: "form-select-custom" %>
        </div>

        <div>
          <%= f.label :frequency, "Frequência", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.select :frequency, Recurrence::FREQUENCIES.map { |f| [f.titleize, f] }, {}, required: true, class: "form-select-custom" %>
        </div>

        <div>
          <%= f.label :interval, "Intervalo (A cada N períodos)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :interval, min: 1, class: "form-input-custom" %>
        </div>

        <div>
          <%= f.label :start_date, "Data de Início", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :start_date, required: true, class: "form-input-custom" %>
        </div>

        <div>
          <%= f.label :end_date, "Data de Término (opcional)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :end_date, class: "form-input-custom" %>
        </div>

        <div>
          <%= f.label :total_occurrences, "Total de Ocorrências (opcional)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :total_occurrences, min: 1, class: "form-input-custom" %>
        </div>

        <div class="sm:col-span-2 flex items-center bg-slate-50 p-3 rounded-xl border border-slate-200/60">
          <%= f.check_box :active, { class: "h-4 w-4 text-brand-600 focus:ring-brand-500 border-slate-300 rounded cursor-pointer" } %>
          <%= f.label :active, "Regra de recorrência ativa", class: "ml-2.5 text-xs font-medium text-slate-700 cursor-pointer select-none" %>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-3 border-t border-slate-100">
        <%= f.submit "Salvar Alterações", class: "btn-primary btn-md text-xs" %>
        <%= link_to "Cancelar", recurrences_path, class: "btn-secondary btn-md text-xs" %>
      </div>
    <% end %>
  </div>
</div>
