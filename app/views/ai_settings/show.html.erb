<% content_for :title, "Configurações de Inteligência Artificial" %>

<div class="space-y-6 max-w-5xl mx-auto">
  <!-- Header / Breadcrumbs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-gray-500 mb-1">
        <span>⚙️ Configurações</span>
        <span>/</span>
        <span class="text-indigo-600 font-semibold">Provedor de IA</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
        🤖 Configurações de Inteligência Artificial
      </h1>
      <p class="text-sm text-gray-500 mt-1 leading-relaxed">
        Defina qual motor de IA (<code class="bg-gray-100 text-indigo-700 px-1 py-0.5 rounded font-mono text-xs">AI_PROVIDER</code>) será o padrão para a Consultoria Financeira, análise de faturas e importações por extrato.
      </p>
    </div>

    <div>
      <%= link_to financial_insights_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-xs font-semibold rounded-lg text-gray-700 bg-white hover:bg-gray-50 shadow-2xs transition" do %>
        💡 Ir para Consultoria IA
        <svg class="ml-1.5 w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      <% end %>
    </div>
  </div>

  <!-- Banner do Provedor Ativo -->
  <div class="rounded-2xl p-5 shadow-xs border <%= @current_provider == 'gemini' ? 'bg-gradient-to-r from-purple-900 via-indigo-900 to-purple-800 text-white border-purple-700' : 'bg-gradient-to-r from-indigo-900 via-slate-900 to-indigo-800 text-white border-indigo-700' %> flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl <%= @current_provider == 'gemini' ? 'bg-purple-500/20 text-purple-200 border border-purple-400/30' : 'bg-emerald-500/20 text-emerald-200 border border-emerald-400/30' %>">
        <%= @current_provider == 'gemini' ? '✨' : '⚡' %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs uppercase tracking-wider font-bold text-indigo-200">Provedor Ativo no Sistema</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-3xs font-bold <%= @current_provider == 'gemini' ? 'bg-purple-400/20 text-purple-200 border border-purple-400/30' : 'bg-emerald-400/20 text-emerald-200 border border-emerald-400/30' %>">
            ATIVO
          </span>
        </div>
        <h2 class="text-xl font-bold mt-0.5">
          <%= @current_provider == 'gemini' ? 'Google Gemini' : 'Groq (LPU Ultra Rápido)' %>
        </h2>
        <p class="text-xs text-indigo-200 mt-0.5">
          Modelo: <strong><%= @current_provider == 'gemini' ? @user.effective_gemini_model : @user.effective_groq_model %></strong>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 self-start sm:self-auto">
      <%= button_to test_connection_ai_settings_path(provider: @current_provider), method: :post, form_class: "inline-flex", class: "btn-secondary btn-md text-xs gap-1.5 shadow-2xs cursor-pointer" do %>
        <svg class="w-3.5 h-3.5 text-brand-600 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Testar Conexão Ativa</span>
      <% end %>
    </div>
  </div>

  <!-- Seleção Visual Rápida de Provedores -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- Card Groq -->
    <div class="bg-white rounded-2xl border-2 transition-all p-6 shadow-sm flex flex-col justify-between <%= @current_provider == 'groq' ? 'border-indigo-600 ring-2 ring-indigo-100' : 'border-gray-200 hover:border-gray-300' %>">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
              ⚡
            </div>
            <div>
              <h3 class="text-base font-bold text-gray-900">Groq (LPU)</h3>
              <p class="text-xs text-gray-500">Inferência de Velocidade Extrema</p>
            </div>
          </div>
          <% if AiService.configured?('groq', @user) %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
              ● Conectado
            </span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
              ⚠️ Não configurado
            </span>
          <% end %>
        </div>

        <p class="text-xs text-gray-600 leading-relaxed mb-4">
          Excelente para cálculos rápidos, identificação de gargalos de liquidez e consultas instantâneas com latência de milissegundos.
        </p>

        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100 text-xs space-y-1.5 font-mono text-gray-700 mb-4">
          <div class="flex justify-between">
            <span class="text-gray-500">Modelo Padrão:</span>
            <span class="font-semibold text-gray-900"><%= @user.effective_groq_model %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Origem da Chave:</span>
            <span class="font-semibold text-gray-900"><%= @user.custom_groq_api_key.present? ? 'Personalizada (Banco)' : (ENV['GROQ_API_KEY'].present? ? 'Arquivo .env' : 'Não definida') %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Latência Típica:</span>
            <span class="font-semibold text-emerald-600">~0.15s</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-4 border-t border-gray-100">
        <% if @current_provider == 'groq' %>
          <button type="button" disabled class="flex-1 py-2 px-3 text-xs font-bold rounded-lg text-emerald-700 bg-emerald-50 border border-emerald-200 text-center cursor-default">
            ✓ Provedor Ativo
          </button>
        <% else %>
          <%= form_with model: @user, url: ai_settings_path, method: :patch, local: true, class: "flex-1" do |f| %>
            <%= f.hidden_field :preferred_ai_provider, value: "groq" %>
            <%= f.button "Ativar Groq", class: "btn-primary btn-sm w-full cursor-pointer" %>
          <% end %>
        <% end %>

        <%= button_to test_connection_ai_settings_path(provider: 'groq'), method: :post, form_class: "inline-flex", class: "btn-secondary btn-sm cursor-pointer" do %>
          Testar
        <% end %>
      </div>
    </div>

    <!-- Card Google Gemini -->
    <div class="bg-white rounded-2xl border-2 transition-all p-6 shadow-sm flex flex-col justify-between <%= @current_provider == 'gemini' ? 'border-purple-600 ring-2 ring-purple-100' : 'border-gray-200 hover:border-gray-300' %>">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl font-bold">
              ✨
            </div>
            <div>
              <h3 class="text-base font-bold text-gray-900">Google Gemini</h3>
              <p class="text-xs text-gray-500">Inteligência Multimodal Avançada</p>
            </div>
          </div>
          <% if AiService.configured?('gemini', @user) %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
              ● Conectado
            </span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
              ⚠️ Não configurado
            </span>
          <% end %>
        </div>

        <p class="text-xs text-gray-600 leading-relaxed mb-4">
          Capacidade analítica superior com raciocínio contextual de ponta. Ideal para leitura de extratos bancários em PDF, documentos complexos e análise financeira aprofundada.
        </p>

        <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-100 text-xs space-y-1.5 font-mono text-gray-700 mb-4">
          <div class="flex justify-between">
            <span class="text-gray-500">Modelo Padrão:</span>
            <span class="font-semibold text-gray-900"><%= @user.effective_gemini_model %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Origem da Chave:</span>
            <span class="font-semibold text-gray-900"><%= @user.custom_gemini_api_key.present? ? 'Personalizada (Banco)' : (ENV['GEMINI_API_KEY'].present? ? 'Arquivo .env' : 'Não definida') %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Capacidades:</span>
            <span class="font-semibold text-purple-600">Multimodal & PDFs</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-4 border-t border-gray-100">
        <% if @current_provider == 'gemini' %>
          <button type="button" disabled class="flex-1 py-2 px-3 text-xs font-bold rounded-lg text-purple-700 bg-purple-50 border border-purple-200 text-center cursor-default">
            ✓ Provedor Ativo
          </button>
        <% else %>
          <%= form_with model: @user, url: ai_settings_path, method: :patch, local: true, class: "flex-1" do |f| %>
            <%= f.hidden_field :preferred_ai_provider, value: "gemini" %>
            <%= f.button "Ativar Gemini", class: "btn-primary btn-sm w-full !bg-purple-600 hover:!bg-purple-700 cursor-pointer" %>
          <% end %>
        <% end %>

        <%= button_to test_connection_ai_settings_path(provider: 'gemini'), method: :post, form_class: "inline-flex", class: "btn-secondary btn-sm cursor-pointer" do %>
          Testar
        <% end %>
      </div>
    </div>
  </div>

  <!-- Formulário Completo de Configurações Detalhadas -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8">
    <div class="border-b border-gray-100 pb-4 mb-6">
      <h3 class="text-lg font-bold text-gray-900">Configurações Avançadas de Modelos e Chaves</h3>
      <p class="text-xs text-gray-500 mt-1">
        Personalize os modelos específicos utilizados por cada motor ou forneça chaves de API individuais (caso não queira usar as variáveis do servidor).
      </p>
    </div>

    <%= form_with model: @user, url: ai_settings_path, method: :patch, local: true, class: "space-y-6" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Coluna Groq -->
        <div class="space-y-4 p-5 rounded-xl bg-gray-50/60 border border-gray-200">
          <div class="flex items-center gap-2">
            <span class="text-lg">⚡</span>
            <h4 class="font-bold text-sm text-gray-900">Parâmetros do Groq</h4>
          </div>

          <div>
            <%= f.label :groq_model, "Modelo Groq", class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.select :groq_model, options_for_select([
              ["openai/gpt-oss-120b (Recomendado - Maior Raciocínio)", "openai/gpt-oss-120b"],
              ["openai/gpt-oss-20b (Mais Rápido / Econômico)", "openai/gpt-oss-20b"]
            ], @user.effective_groq_model), {}, class: "block w-full rounded-lg border-gray-300 text-xs shadow-xs focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="text-3xs text-gray-400 mt-1">Modelo padrão configurado no .env: <%= ENV.fetch("GROQ_MODEL", "openai/gpt-oss-120b") %></p>
          </div>

          <div>
            <%= f.label :custom_groq_api_key, "Chave de API do Groq (Opcional)", class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.password_field :custom_groq_api_key, placeholder: @user.custom_groq_api_key.present? ? "••••••••••••••••" : (ENV['GROQ_API_KEY'].present? ? "Definida no .env (deixe vazio para usar)" : "Insira sua gsk_..."), class: "block w-full rounded-lg border-gray-300 text-xs shadow-xs focus:ring-indigo-500 focus:border-indigo-500 font-mono" %>
            <p class="text-3xs text-gray-400 mt-1">Deixe em branco para usar a chave <code class="bg-gray-200 px-1 rounded">GROQ_API_KEY</code> do servidor.</p>
          </div>
        </div>

        <!-- Coluna Gemini -->
        <div class="space-y-4 p-5 rounded-xl bg-gray-50/60 border border-gray-200">
          <div class="flex items-center gap-2">
            <span class="text-lg">✨</span>
            <h4 class="font-bold text-sm text-gray-900">Parâmetros do Google Gemini</h4>
          </div>

          <div>
            <%= f.label :gemini_model, "Modelo Google Gemini", class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.select :gemini_model, options_for_select([
              ["gemini-3.5-flash (Recomendado - Raciocínio & Visão)", "gemini-3.5-flash"],
              ["gemini-3.5-flash-lite (Ultra Rápido / Baixa Latência)", "gemini-3.5-flash-lite"]
            ], @user.effective_gemini_model), {}, class: "block w-full rounded-lg border-gray-300 text-xs shadow-xs focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="text-3xs text-gray-400 mt-1">Modelo padrão configurado no .env: <%= ENV.fetch("GEMINI_MODEL", "gemini-3.5-flash") %></p>
          </div>

          <div>
            <%= f.label :custom_gemini_api_key, "Chave de API do Gemini (Opcional)", class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.password_field :custom_gemini_api_key, placeholder: @user.custom_gemini_api_key.present? ? "••••••••••••••••" : (ENV['GEMINI_API_KEY'].present? ? "Definida no .env (deixe vazio para usar)" : "Insira sua AQ..."), class: "block w-full rounded-lg border-gray-300 text-xs shadow-xs focus:ring-indigo-500 focus:border-indigo-500 font-mono" %>
            <p class="text-3xs text-gray-400 mt-1">Deixe em branco para usar a chave <code class="bg-gray-200 px-1 rounded">GEMINI_API_KEY</code> do servidor.</p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-gray-100">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-gray-700">Provedor Ativo Selecionado:</span>
          <div class="flex items-center gap-4">
            <label class="inline-flex items-center text-xs font-medium text-gray-900 cursor-pointer">
              <%= f.radio_button :preferred_ai_provider, "groq", class: "mr-1.5 text-indigo-600 focus:ring-indigo-500" %>
              ⚡ Groq (LPU)
            </label>
            <label class="inline-flex items-center text-xs font-medium text-gray-900 cursor-pointer">
              <%= f.radio_button :preferred_ai_provider, "gemini", class: "mr-1.5 text-purple-600 focus:ring-purple-500" %>
              ✨ Google Gemini
            </label>
          </div>
        </div>

        <%= f.button "Salvar Alterações de IA", class: "btn-primary btn-md text-xs cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
