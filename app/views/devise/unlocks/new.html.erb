<div class="min-h-screen bg-slate-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md app-card p-8">
    <div class="text-center mb-6">
      <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white font-extrabold text-xl flex items-center justify-center mx-auto mb-3 shadow-md shadow-brand-500/20">
        ⚡
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Desbloquear Conta</h1>
      <p class="text-xs text-slate-500 mt-1">Reenviar instruções para desbloquear seu acesso</p>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }, local: true) do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email, "Email", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "form-input-custom" %>
        </div>
      </div>

      <button type="submit" class="w-full mt-6 btn-primary py-3 text-sm font-bold shadow-md hover:shadow-lg transition cursor-pointer">
        Reenviar Instruções
      </button>
    <% end %>

    <div class="mt-6 border-t border-slate-100 pt-5 text-center text-xs text-slate-500">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
