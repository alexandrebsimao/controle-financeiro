<div class="min-h-screen bg-gradient-to-br from-slate-50 via-brand-50/40 to-slate-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    
    <!-- Logo & Brand Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-700 via-brand-600 to-indigo-500 text-white font-extrabold text-2xl shadow-lg shadow-brand-500/25 mb-3">
        ⚡
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Finances</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Gestão financeira pessoal e empresarial com IA</p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-3xl shadow-elevated border border-slate-100/80 p-8 sm:p-10">
      <h2 class="text-lg font-bold text-slate-900 mb-6 text-center">Entrar na sua conta</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true) do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :email, "Email", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "form-input-custom" %>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <%= f.label :password, "Senha", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider" %>
              <%- if devise_mapping.recoverable? %>
                <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs font-semibold text-brand-600 hover:text-brand-800 transition" %>
              <% end %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", class: "form-input-custom" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center pt-1">
              <%= f.check_box :remember_me, { class: "h-4 w-4 text-brand-600 focus:ring-brand-500 border-slate-300 rounded cursor-pointer" } %>
              <%= f.label :remember_me, "Manter-me conectado", class: "ml-2 block text-xs font-medium text-slate-600 cursor-pointer select-none" %>
            </div>
          <% end %>
        </div>

        <button type="submit" class="w-full mt-6 btn-primary py-3 text-sm font-bold shadow-md hover:shadow-lg transition">
          Fazer Login
        </button>
      <% end %>

      <div class="mt-8 border-t border-slate-100 pt-6 text-center">
        <p class="text-xs text-slate-500">
          Não tem uma conta ainda?
          <%= link_to "Criar Conta", new_registration_path(resource_name), class: "font-bold text-brand-600 hover:text-brand-800 transition ml-1" %>
        </p>
      </div>
    </div>

  </div>
</div>
