<% content_for :title, "Editar Perfil • Finances" %>

<div class="max-w-2xl mx-auto space-y-6">
  <div class="app-card p-6 sm:p-8">
    <div class="border-b border-slate-100 pb-5 mb-6">
      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">Editar Perfil</h1>
      <p class="text-xs text-slate-500 mt-1">Atualize seus dados pessoais e credenciais de acesso</p>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, local: true) do |f| %>
      <div class="space-y-5">
        <div>
          <%= f.label :name, "Nome Completo", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :name, autocomplete: "name", class: "form-input-custom" %>
        </div>

        <div>
          <%= f.label :email, "Email", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input-custom" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5">
            <p class="text-xs font-semibold text-amber-800">
              Aguardando confirmação para: <strong><%= resource.unconfirmed_email %></strong>
            </p>
          </div>
        <% end %>

        <div class="pt-5 border-t border-slate-100">
          <h2 class="text-sm font-bold text-slate-900 mb-0.5">Alterar Senha</h2>
          <p class="text-xs text-slate-400 mb-4">Deixe em branco caso não queira alterar sua senha atual</p>

          <div class="space-y-4">
            <div>
              <%= f.label :password, "Nova Senha", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "form-input-custom font-mono" %>
              <% if @minimum_password_length %>
                <p class="text-[11px] text-slate-400 mt-1">Mínimo de <%= @minimum_password_length %> caracteres</p>
              <% end %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "form-input-custom font-mono" %>
            </div>

            <div class="pt-2">
              <%= f.label :current_password, "Senha Atual", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
              <p class="text-[11px] text-slate-400 mb-1.5">Necessário informar sua senha atual para confirmar as alterações</p>
              <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "••••••••", class: "form-input-custom font-mono" %>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 mt-8 pt-5 border-t border-slate-100">
        <%= f.submit "Salvar Alterações", class: "btn-primary btn-md text-xs cursor-pointer" %>
        <%= link_to "Voltar", :back, class: "btn-secondary btn-md text-xs" %>
      </div>
    <% end %>
  </div>

  <div class="app-card p-6 border-rose-200 bg-rose-50/20">
    <h3 class="text-sm font-bold text-rose-900 mb-1">Zona de Perigo: Cancelar Conta</h3>
    <p class="text-xs text-rose-700 mb-4">Essa ação não pode ser desfeita. Todos os seus dados, movimentações e contas serão excluídos permanentemente.</p>
    <%= button_to "Cancelar Minha Conta", registration_path(resource_name), 
        data: { turbo_confirm: "Tem certeza absoluta? Essa ação não pode ser desfeita." }, 
        method: :delete,
        form_class: "inline-flex",
        class: "btn-danger btn-md text-xs cursor-pointer" %>
  </div>
</div>
