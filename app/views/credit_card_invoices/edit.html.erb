<% content_for :title, "Pagar Fatura #{@invoice.reference_label} • Finances" %>

<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Liquidar Fatura <%= @invoice.reference_label %></h1>
      <p class="text-xs text-slate-500 mt-0.5">Cartão <%= @credit_card.name %></p>
    </div>
    <%= link_to "← Voltar ao Cartão", credit_card_path(@credit_card), class: "text-xs font-semibold text-slate-500 hover:text-slate-800" %>
  </div>

  <div class="app-card p-6 sm:p-8">
    <%= form_with model: [@credit_card, @invoice], url: pay_credit_card_invoice_path(@credit_card, @invoice), method: :post, local: true, class: "space-y-6" do |f| %>
      <div class="rounded-2xl bg-indigo-50/70 border border-indigo-100 p-5 space-y-3">
        <h3 class="text-xs font-bold text-indigo-950 uppercase tracking-wider">Resumo do Pagamento</h3>
        <dl class="space-y-2 text-xs">
          <div class="flex justify-between items-center py-1 border-b border-indigo-100/60">
            <dt class="text-indigo-800">Fatura Referência:</dt>
            <dd class="text-indigo-950 font-bold"><%= @invoice.reference_label %></dd>
          </div>
          <div class="flex justify-between items-center py-1 border-b border-indigo-100/60">
            <dt class="text-indigo-800">Valor Total:</dt>
            <dd class="text-rose-600 font-extrabold text-base"><%= number_to_currency(@invoice.total_amount, unit: "R$", separator: ",", delimiter: ".") %></dd>
          </div>
          <div class="flex justify-between items-center py-1">
            <dt class="text-indigo-800">Data de Vencimento:</dt>
            <dd class="text-indigo-950 font-bold"><%= @invoice.due_date.strftime("%d/%m/%Y") %></dd>
          </div>
        </dl>
      </div>

      <div>
        <%= f.label :bank_account_id, "Débito da Conta Bancária", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
        <%= f.select :bank_account_id, current_user_bank_accounts.map { |ba| ["#{ba.name} (Saldo: #{number_to_currency(ba.balance, unit: 'R$', separator: ',', delimiter: '.')})", ba.id] }, { prompt: "Selecione a conta para pagamento" }, required: true, class: "form-select-custom" %>
        <p class="mt-1.5 text-[11px] text-slate-400">O saldo da conta selecionada será atualizado e a despesa registrada automaticamente.</p>
      </div>

      <div class="flex items-center gap-3 pt-3 border-t border-slate-100">
        <%= f.submit "Confirmar Pagamento", class: "btn-success btn-md text-xs cursor-pointer" %>
        <%= link_to "Cancelar", credit_card_path(@credit_card), class: "btn-secondary btn-md text-xs" %>
      </div>
    <% end %>
  </div>
</div>
