<div class="space-y-6" data-controller="modal">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Fatura <%= @invoice.reference_label %></h1>
        <span class="badge badge-purple text-xs"><%= @credit_card.name %></span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Detalhamento e conciliação de compras da fatura</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% if !@invoice.paid? %>
        <button type="button" class="btn-success btn-md text-xs gap-1" data-action="click->modal#open" data-modal-id="paymentModal">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span>Pagar Fatura</span>
        </button>
      <% end %>
      <%= link_to financial_insights_path, class: "btn-secondary btn-md text-xs text-brand-700 bg-brand-50 border-brand-200" do %>
        ⚡ Consultoria IA
      <% end %>
      <%= link_to credit_card_invoice_path(@credit_card, @invoice, format: :csv), target: "_blank", class: "btn-secondary btn-md text-xs text-slate-600" do %>
        Exportar CSV
      <% end %>
      <%= link_to "← Voltar ao Cartão", credit_card_path(@credit_card), class: "btn-secondary btn-md text-xs" %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="app-card p-4 sm:p-5 flex flex-col justify-between">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Período da Fatura</span>
      <p class="text-xl font-extrabold mt-1 text-slate-900"><%= @invoice.reference_label %></p>
      <span class="text-[10px] text-slate-400 mt-1">Fechamento: <%= @invoice.closing_date.strftime("%d/%m") %></span>
    </div>

    <div class="app-card p-4 sm:p-5 flex flex-col justify-between">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Valor Total</span>
      <p class="text-xl font-extrabold mt-1 text-rose-600"><%= number_to_currency(@invoice.total_amount, unit: "R$", separator: ",", delimiter: ".") %></p>
      <span class="text-[10px] text-slate-400 mt-1">Fatura do cartão</span>
    </div>

    <div class="app-card p-4 sm:p-5 flex flex-col justify-between">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Vencimento</span>
      <p class="text-xl font-extrabold mt-1 text-slate-900"><%= @invoice.due_date.strftime("%d/%m/%Y") %></p>
      <span class="text-[10px] text-slate-400 mt-1">Data limite pagamento</span>
    </div>

    <div class="app-card p-4 sm:p-5 flex flex-col justify-between">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Status da Fatura</span>
      <div class="mt-1">
        <% if @invoice.overdue? %>
          <span class="badge badge-danger text-xs">Atrasado</span>
        <% elsif @invoice.paid? %>
          <span class="badge badge-success text-xs">Pago</span>
        <% else %>
          <span class="badge badge-warning text-xs">Pendente</span>
        <% end %>
      </div>
      <span class="text-[10px] text-slate-400 mt-1"><%= @invoice.paid_at ? "Pago em #{@invoice.paid_at.strftime('%d/%m/%Y')}" : "Aguardando pagamento" %></span>
    </div>
  </div>

  <!-- Details -->
  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Detalhes da Fatura</h3>
    </div>
    <div class="px-4 py-5 sm:p-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Data de Fechamento</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @invoice.closing_date.strftime("%d/%m/%Y") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Data de Vencimento</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @invoice.due_date.strftime("%d/%m/%Y") %></dd>
        </div>

        <% if @invoice.paid_at %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Data de Pagamento</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @invoice.paid_at.strftime("%d/%m/%Y") %></dd>
          </div>
        <% end %>

        <% if @invoice.paid_by_transaction %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Transação Relacionada</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= link_to "Transação ##{@invoice.paid_by_transaction.id}", transaction_path(@invoice.paid_by_transaction), class: "text-blue-600 hover:text-blue-800" %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>

  <!-- Expenses -->
  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Despesas Registradas</h3>
    </div>

    <div class="px-4 py-5 sm:p-6 border-b border-gray-200 space-y-4">
      <% if @preview_rows.blank? %>
        <div>
          <h4 class="text-base font-semibold text-gray-900">Importar Fatura via CSV</h4>
          <p class="text-sm text-gray-500">Faça upload do extrato ou fatura em CSV exportado do seu banco.</p>
        </div>

        <div class="bg-gray-50 border border-dashed border-gray-300 rounded-lg p-5">
          <%= form_with url: preview_csv_import_credit_card_invoice_path(@credit_card, @invoice), method: :post, local: true, multipart: true, data: { turbo: false }, class: "space-y-4" do |f| %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Selecionar arquivo CSV</label>
              <%= file_field_tag :csv_file, accept: ".csv,text/csv,text/plain", required: true, class: "block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 border border-gray-300 rounded-md bg-white cursor-pointer p-1" %>
              <p class="mt-1 text-xs text-gray-500">Compatível com Nubank, Itaú, Bradesco, Inter, Santander, C6, XP, Rico e outros (detecta codificação e separadores automaticamente).</p>
            </div>

            <div>
              <%= f.submit "Gerar prévia da importação", class: "btn-primary btn-md text-xs cursor-pointer" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-gray-200">
            <div>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mb-1">
                ✓ Prévia Gerada
              </span>
              <h4 class="text-base font-semibold text-gray-900">
                <%= @preview_rows.size %> compra(s) identificada(s) no CSV
              </h4>
              <p class="text-xs text-slate-500">Selecione quais compras deseja vincular a esta fatura.</p>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to "Carregar outro arquivo", clear_csv_preview_credit_card_invoice_path(@credit_card, @invoice), class: "btn-secondary btn-sm text-xs" %>
            </div>
          </div>

          <% if @csv_headers.present? %>
            <details class="group bg-gray-50 border border-gray-200 rounded-md p-3 text-sm">
              <summary class="font-medium text-gray-700 cursor-pointer flex items-center justify-between select-none">
                <span>⚙️ Mapeamento de colunas detectado (clique para ajustar se necessário)</span>
                <span class="text-xs text-indigo-600 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="mt-3 pt-3 border-t border-gray-200">
                <p class="text-xs text-gray-500 mb-3">Se alguma coluna foi identificada incorretamente, ajuste os campos e recalcule a prévia:</p>
                <%= form_with url: preview_csv_import_credit_card_invoice_path(@credit_card, @invoice), method: :post, local: true, data: { turbo: false }, class: "space-y-3" do |f| %>
                  <% if @raw_csv_content.present? %>
                    <input type="hidden" name="raw_csv_content" value="<%= @raw_csv_content %>">
                  <% end %>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    <% fields = {
                      "title" => "Descrição",
                      "amount" => "Valor (ou Débito)",
                      "credit_amount" => "Valor de Crédito / Reembolso (opcional)",
                      "transaction_type" => "Tipo / Operação (Débito/Crédito)",
                      "due_date" => "Vencimento",
                      "purchased_at" => "Data da compra",
                      "installments" => "Parcelas",
                      "notes" => "Observações"
                    } %>
                    <% fields.each do |field_key, field_label| %>
                      <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1"><%= field_label %></label>
                        <%= select_tag "field_mapping[#{field_key}]",
                          options_for_select([["Não importar", ""]] + @csv_headers.to_a.map { |h| [h, h] }, @field_mapping&.dig(field_key)),
                          class: "block w-full rounded-md border border-gray-300 p-1.5 text-xs bg-white" %>
                      </div>
                    <% end %>
                  </div>
                  <div>
                    <%= f.submit "Recalcular prévia com novo mapeamento", class: "btn-secondary btn-sm text-xs cursor-pointer" %>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>

          <%= form_with url: import_csv_credit_card_invoice_path(@credit_card, @invoice), method: :post, local: true, data: { turbo: false }, class: "space-y-4" do %>
            <input type="hidden" name="preview_rows_json" value="<%= @preview_rows.to_json %>">

            <div class="overflow-x-auto border border-gray-200 rounded-md bg-white shadow-sm max-h-96">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 sticky top-0 z-10">
                  <tr>
                    <th class="px-3 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12">
                      <input type="checkbox" id="selectAllRows" checked class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" onclick="toggleAllPreviewRows(this)">
                    </th>
                    <th class="px-3 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
                    <th class="px-3 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Descrição</th>
                    <th class="px-3 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Valor</th>
                    <th class="px-3 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Data da Compra</th>
                    <th class="px-3 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vencimento</th>
                    <th class="px-3 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Parcelas</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <% @preview_rows.each do |row| %>
                    <% row = row.with_indifferent_access %>
                    <% is_refund = row[:is_refund] == true || row[:is_refund] == "true" %>
                    <% is_payment = row[:is_invoice_payment] == true || row[:is_invoice_payment] == "true" %>
                    <tr class="hover:bg-gray-50 <%= 'bg-emerald-50/40' if is_refund %> <%= 'bg-gray-50/60 opacity-75' if is_payment %>">
                      <td class="px-3 py-2 text-sm">
                        <input type="checkbox" name="selected_rows[]" value="<%= row[:row_id] %>" <%= "checked" unless is_payment %> class="preview-row-checkbox rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" onchange="updatePreviewSelectionCount()">
                      </td>
                      <td class="px-3 py-2 text-xs whitespace-nowrap">
                        <% if is_refund %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-100 text-emerald-800">
                            Reembolso / Estorno
                          </span>
                        <% elsif is_payment %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-gray-100 text-gray-700">
                            Pagamento de Fatura
                          </span>
                        <% else %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700">
                            Compra
                          </span>
                        <% end %>
                      </td>
                      <td class="px-3 py-2 text-sm font-medium text-gray-900"><%= row[:title] %></td>
                      <td class="px-3 py-2 text-sm whitespace-nowrap">
                        <% amt = row[:amount].to_f %>
                        <% if is_refund %>
                          <span class="text-emerald-600 font-bold">- <%= number_to_currency(amt.abs, unit: "R$", separator: ",", delimiter: ".") %></span>
                        <% elsif is_payment %>
                          <span class="text-gray-500 font-medium">- <%= number_to_currency(amt.abs, unit: "R$", separator: ",", delimiter: ".") %></span>
                        <% else %>
                          <span class="text-red-600 font-semibold"><%= number_to_currency(amt.abs, unit: "R$", separator: ",", delimiter: ".") %></span>
                        <% end %>
                      </td>
                      <td class="px-3 py-2 text-sm text-gray-600 whitespace-nowrap">
                        <% p_date = row[:purchased_at] %>
                        <%= p_date.present? ? (Date.parse(p_date.to_s).strftime("%d/%m/%Y") rescue p_date) : "-" %>
                      </td>
                      <td class="px-3 py-2 text-sm text-gray-600 whitespace-nowrap">
                        <% d_date = row[:due_date] %>
                        <%= d_date.present? ? (Date.parse(d_date.to_s).strftime("%d/%m/%Y") rescue d_date) : "-" %>
                      </td>
                      <td class="px-3 py-2 text-sm text-gray-600 whitespace-nowrap"><%= row[:installments] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-2">
              <p class="text-sm text-gray-600">
                <span id="selectedCount" class="font-semibold text-gray-900"><%= @preview_rows.count { |r| !(r[:is_invoice_payment] == true || r[:is_invoice_payment] == "true" || r['is_invoice_payment'] == true || r['is_invoice_payment'] == "true") } %></span> de <%= @preview_rows.size %> itens selecionados para importação.
                <% if @preview_rows.any? { |r| r[:is_invoice_payment] == true || r[:is_invoice_payment] == "true" || r['is_invoice_payment'] == true || r['is_invoice_payment'] == "true" } %>
                  <span class="text-xs text-gray-400 block sm:inline sm:ml-2">(Pagamentos de fatura desmarcados por padrão)</span>
                <% end %>
              </p>
              <div class="flex items-center gap-2">
                <%= link_to "Cancelar prévia", clear_csv_preview_credit_card_invoice_path(@credit_card, @invoice), class: "btn-secondary btn-md text-xs" %>
                <button type="submit" class="btn-success btn-md text-xs cursor-pointer">
                  Confirmar importação
                </button>
              </div>
            </div>
          <% end %>

          <script>
            function toggleAllPreviewRows(master) {
              document.querySelectorAll('.preview-row-checkbox').forEach(function(cb) {
                cb.checked = master.checked;
              });
              updatePreviewSelectionCount();
            }

            function updatePreviewSelectionCount() {
              var count = document.querySelectorAll('.preview-row-checkbox:checked').length;
              var el = document.getElementById('selectedCount');
              if (el) el.innerText = count;
            }
          </script>
        </div>
      <% end %>
    </div>

    <% if @expenses.any? %>
      <div class="overflow-x-auto">
        <table class="app-table">
          <thead>
            <tr>
              <th>Descrição</th>
              <th>Categoria</th>
              <th>Parcela</th>
              <th>Data de Vencimento</th>
              <th>Valor</th>
              <th class="text-right w-16">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @expenses.each do |expense| %>
              <% is_refund_expense = expense.amount < 0 %>
              <tr class="<%= 'bg-emerald-50/30' if is_refund_expense %>">
                <td>
                  <div class="flex items-center gap-2">
                    <% if is_refund_expense %>
                      <span class="badge badge-success text-[10px]">
                        Reembolso
                      </span>
                    <% end %>
                    <span class="font-bold text-slate-900">
                      <%= link_to expense.credit_card_purchase.title, credit_card_purchase_path(@credit_card, expense.credit_card_purchase), class: "hover:text-brand-600 transition" %>
                    </span>
                  </div>
                </td>
                <td class="text-xs text-slate-600">
                  <% if expense.credit_card_purchase.category %>
                    <span class="font-medium text-slate-700"><%= expense.credit_card_purchase.category.name %></span>
                  <% else %>
                    <span class="text-slate-300">-</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap text-xs text-slate-600">
                  <span class="badge badge-neutral"><%= "#{expense.installment_number}/#{expense.credit_card_purchase.installments}" %></span>
                </td>
                <td class="whitespace-nowrap text-xs text-slate-600">
                  <%= expense.due_date.strftime("%d/%m/%Y") %>
                </td>
                <td class="whitespace-nowrap font-bold">
                  <% if is_refund_expense %>
                    <span class="text-emerald-600">- <%= number_to_currency(expense.amount.abs, unit: "R$", separator: ",", delimiter: ".") %></span>
                  <% else %>
                    <span class="text-rose-600"><%= number_to_currency(expense.amount, unit: "R$", separator: ",", delimiter: ".") %></span>
                  <% end %>
                </td>
                <td class="text-right">
                  <div class="relative inline-block text-left" data-controller="dropdown">
                    <button type="button" class="action-menu-btn" data-dropdown-target="button" data-action="click->dropdown#toggle" title="Ações" aria-label="Menu de ações">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                      </svg>
                    </button>

                    <div data-dropdown-target="menu" class="hidden action-menu-dropdown">
                      <%= link_to credit_card_purchase_path(@credit_card, expense.credit_card_purchase), class: "action-menu-item" do %>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <span>Ver Compra</span>
                      <% end %>
                      <%= link_to edit_credit_card_purchase_path(@credit_card, expense.credit_card_purchase), class: "action-menu-item" do %>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        <span>Editar Compra</span>
                      <% end %>
                      <div class="action-menu-divider"></div>
                      <%= button_to credit_card_purchase_path(@credit_card, expense.credit_card_purchase), method: :delete, data: { turbo_confirm: "Tem certeza? Isto irá remover a compra inteira." }, class: "action-menu-item action-menu-item-danger" do %>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        <span>Remover</span>
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500">Nenhuma despesa registrada nesta fatura.</p>
      </div>
    <% end %>
  </div>

  <!-- Modal de Pagamento -->
  <% if !@invoice.paid? %>
    <div id="paymentModal" class="fixed z-10 inset-0 overflow-y-auto hidden" aria-labelledby="payment-modal" role="dialog" aria-modal="true">
      <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" data-action="click->modal#close"></div>
        
        <!-- Modal panel -->
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
          <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                <h3 class="text-lg leading-6 font-medium text-gray-900" id="payment-modal">
                  Confirmar Pagamento de Fatura
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500">
                    Você está prestes a pagar a fatura de <strong><%= @credit_card.name %></strong> do período <strong><%= @invoice.reference_label %></strong>.
                  </p>
                </div>
                
                <!-- Payment form -->
                <%= form_with model: @invoice, url: pay_credit_card_invoice_path(@credit_card, @invoice), method: :post, local: true, class: "mt-6 space-y-4", data: { "modal-target": "form" } do |form| %>
                  <div>
                    <label for="bank_account_id" class="block text-sm font-medium text-gray-700">Conta Bancária</label>
                    <select id="bank_account_id" name="credit_card_invoice[bank_account_id]" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" data-modal-target="bankAccountSelect" data-action="change->modal#hideErrorOnChange">
                      <option value="">Selecione uma conta bancária</option>
                      <% current_user.bank_accounts.each do |account| %>
                        <option value="<%= account.id %>" <% if account.id == @credit_card.bank_account_id %> selected <% end %>>
                          <%= account.name %> - Saldo: <%= number_to_currency(account.balance, unit: "R$", separator: ",", delimiter: ".") %>
                        </option>
                      <% end %>
                    </select>
                  </div>

                  <div class="bg-gray-50 p-4 rounded-md">
                    <div class="flex justify-between items-center">
                      <span class="text-gray-600">Valor a pagar:</span>
                      <span class="text-xl font-bold text-red-600"><%= number_to_currency(@invoice.total_amount, unit: "R$", separator: ",", delimiter: ".") %></span>
                    </div>
                  </div>

                  <div id="errorMessage" class="rounded-md bg-red-50 p-4 hidden" data-modal-error>
                    <div class="flex">
                      <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm font-medium text-red-800" id="errorText" data-modal-error-text></p>
                      </div>
                    </div>
                  </div>

                  <div class="mt-5 sm:mt-6 flex gap-3">
                    <button type="submit" class="flex-1 btn-success btn-md text-xs cursor-pointer">
                      Confirmar Pagamento
                    </button>
                    <button type="button" data-action="click->modal#close" class="flex-1 btn-secondary btn-md text-xs cursor-pointer">
                      Cancelar
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
