<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header / Breadcrumbs -->
  <div class="flex items-center justify-between">
    <div>
      <%= link_to transactions_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700 mb-2 transition" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Voltar para Movimentações
      <% end %>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 flex items-center gap-2">
        <span>📄 Importar Extrato Bancário</span>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-indigo-100 text-indigo-800">
          PDF • OFX • CSV
        </span>
      </h1>
      <p class="mt-1 text-sm text-gray-500">
        Envie seu extrato bancário em <strong>PDF, OFX ou CSV</strong> (compatível com <strong>Nubank</strong>, Inter, Itaú, Bradesco, Santander, etc.). O motor de IA irá ler os lançamentos, categorizá-los e cruzar com seus dados existentes para evitar duplicatas.
      </p>
    </div>
  </div>

  <!-- Form Card -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <%= form_with url: preview_transaction_imports_path, method: :post, multipart: true, local: true, class: "p-6 space-y-6", data: { turbo: false, controller: "statement-upload", action: "submit->statement-upload#onSubmit" } do |f| %>
      
      <!-- Passo 1: Conta Bancária -->
      <div>
        <label for="bank_account_id" class="block text-sm font-semibold text-gray-800 mb-1">
          1. Selecione a Conta Bancária de Destino <span class="text-red-500">*</span>
        </label>
        <p class="text-xs text-gray-500 mb-2">As movimentações importadas serão associadas a esta conta.</p>
        
        <% if @bank_accounts.any? %>
          <div class="relative">
            <select name="bank_account_id" id="bank_account_id" required class="block w-full rounded-lg border border-gray-300 py-2.5 pl-3 pr-10 text-sm text-gray-900 focus:border-indigo-500 focus:ring-indigo-500 shadow-sm bg-white">
              <% @bank_accounts.each do |account| %>
                <option value="<%= account.id %>" <%= 'selected' if params[:bank_account_id].to_s == account.id.to_s %>>
                  🏦 <%= account.name %> (Saldo atual: <%= account.formatted_balance rescue number_to_currency(account.balance, unit: "R$ ", separator: ",", delimiter: ".") %>)
                </option>
              <% end %>
            </select>
          </div>
        <% else %>
          <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-sm text-yellow-800 flex items-center justify-between">
            <span>Você ainda não possui nenhuma conta bancária cadastrada.</span>
            <%= link_to "Cadastrar Conta", new_bank_account_path, class: "font-medium underline hover:text-yellow-900 ml-4" %>
          </div>
        <% end %>
      </div>

      <!-- Passo 2: Provedor de IA -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-sm font-semibold text-gray-800">
            2. Escolha o Motor de Inteligência Artificial <span class="text-red-500">*</span>
          </label>
          <%= link_to "⚙️ Configurar chaves de IA", ai_settings_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-800 transition" %>
        </div>
        <p class="text-xs text-gray-500 mb-3">Você pode escolher entre Groq ou Google Gemini para processar a leitura do extrato:</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Opção Groq -->
          <% groq = @providers.find { |p| p[:id] == "groq" } %>
          <label class="relative flex flex-col p-4 border rounded-xl cursor-pointer transition hover:border-indigo-400 <%= @selected_provider == 'groq' ? 'border-indigo-600 bg-indigo-50/40 ring-2 ring-indigo-500' : 'border-gray-200 bg-white' %>">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <input type="radio" name="provider" value="groq" class="text-indigo-600 focus:ring-indigo-500 h-4 w-4" <%= 'checked' if @selected_provider == 'groq' %>>
                <span class="font-bold text-gray-900 text-sm">⚡ Groq (LPU Ultra Rápido)</span>
              </div>
              <% if groq && groq[:configured] %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800">Pronto</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">Sem Chave</span>
              <% end %>
            </div>
            <p class="mt-2 text-xs text-gray-600">
              Extração instantânea para PDFs com texto nativo. Modelo: <code class="bg-gray-100 px-1 py-0.5 rounded text-[11px]"><%= groq ? groq[:active_model] : "openai/gpt-oss-120b" %></code>.
            </p>
          </label>

          <!-- Opção Gemini -->
          <% gemini = @providers.find { |p| p[:id] == "gemini" } %>
          <label class="relative flex flex-col p-4 border rounded-xl cursor-pointer transition hover:border-indigo-400 <%= @selected_provider == 'gemini' ? 'border-indigo-600 bg-indigo-50/40 ring-2 ring-indigo-500' : 'border-gray-200 bg-white' %>">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <input type="radio" name="provider" value="gemini" class="text-indigo-600 focus:ring-indigo-500 h-4 w-4" <%= 'checked' if @selected_provider == 'gemini' %>>
                <span class="font-bold text-gray-900 text-sm">✨ Google Gemini</span>
              </div>
              <% if gemini && gemini[:configured] %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800">Pronto</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">Sem Chave</span>
              <% end %>
            </div>
            <p class="mt-2 text-xs text-gray-600">
              Visão multimodal de alta precisão. Lê inclusive extratos escaneados ou imagens. Modelo: <code class="bg-gray-100 px-1 py-0.5 rounded text-[11px]"><%= gemini ? gemini[:active_model] : "gemini-3.5-flash" %></code>.
            </p>
          </label>
        </div>
      </div>

      <!-- Passo 3: Arquivo do Extrato -->
      <div>
        <label for="statement_file" class="block text-sm font-semibold text-gray-800 mb-1">
          3. Arquivo do Extrato (PDF, OFX ou CSV) <span class="text-red-500">*</span>
        </label>
        <p class="text-xs text-gray-500 mb-2">Suporte nativo para exportações do Nubank, Inter, Itaú, Bradesco, Santander, Banco do Brasil, Caixa, C6, etc.</p>

        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-dashed border-gray-300 rounded-xl hover:border-indigo-400 transition bg-gray-50/50" id="drop-area">
          <div class="space-y-2 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex text-sm text-gray-600 justify-center">
              <label for="statement_file" class="relative cursor-pointer bg-white rounded-md font-medium text-indigo-600 hover:text-indigo-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-indigo-500 px-3 py-1 shadow-sm border border-gray-200">
                <span>Selecionar Arquivo (PDF, OFX ou CSV)</span>
                <input id="statement_file" name="statement_file" type="file" accept=".pdf,.ofx,.csv,.txt,application/pdf,text/csv,text/plain" required class="sr-only" onchange="document.getElementById('file-chosen-text').innerText = this.files[0] ? ('📎 ' + this.files[0].name + ' (' + (this.files[0].size/1024).toFixed(1) + ' KB)') : 'Nenhum arquivo selecionado';">
              </label>
            </div>
            <p id="file-chosen-text" class="text-xs font-medium text-gray-700">Nenhum arquivo selecionado</p>
            <p class="text-xs text-gray-400">Arquivos OFX (Nubank), CSV ou PDF até 25MB</p>
          </div>
        </div>
      </div>

      <!-- Passo 4: Opções adicionais -->
      <div class="pt-2 border-t border-gray-100">
        <label class="flex items-start space-x-3 cursor-pointer">
          <input type="checkbox" name="mark_paid" value="1" checked class="rounded border-gray-300 text-indigo-600 shadow-sm focus:ring-indigo-500 mt-0.5 h-4 w-4">
          <div>
            <span class="text-sm font-semibold text-gray-800">Marcar movimentações como já liquidadas / pagas</span>
            <p class="text-xs text-gray-500">Como são itens presentes em um extrato bancário passado, geralmente já foram debitados ou creditados e devem atualizar o saldo da conta.</p>
          </div>
        </label>
      </div>

      <!-- Botão de Envio com Loading State -->
      <div class="flex items-center justify-between pt-4 border-t border-slate-100">
        <%= link_to "Cancelar", transactions_path, class: "btn-secondary btn-md text-xs" %>
        
        <button type="submit" id="submit-btn" class="btn-primary btn-md gap-2 text-xs shadow-sm cursor-pointer">
          <svg id="submit-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <svg id="loading-spinner" class="animate-spin -ml-1 h-4 w-4 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span id="btn-text">Analisar Extrato com IA</span>
        </button>
      </div>
    <% end %>
  </div>

  <!-- Dicas de Segurança e Uso -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-xs text-gray-600 space-y-2">
    <div class="font-semibold text-gray-800 flex items-center gap-1.5">
      <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Como funciona a importação inteligente:
    </div>
    <ul class="list-disc pl-5 space-y-1">
      <li><strong>Prévia antes de salvar:</strong> Nenhuma transação é gravada diretamente no banco de dados. Você verá uma tela de prévia onde poderá revisar, alterar categorias, desmarcar itens indesejados ou ajustar valores.</li>
      <li><strong>Filtro inteligente de saldos:</strong> A IA descarta automaticamente demonstrativos de saldo diário, saldo anterior e linhas informativas.</li>
      <li><strong>Detecção de duplicatas:</strong> Se você já cadastrou manualmente um Pix ou boleto naquele mesmo dia e valor, a IA detectará e desmarcará a linha para evitar lançamentos duplicados.</li>
    </ul>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form[action="<%= preview_transaction_imports_path %>"]');
    if (form) {
      form.addEventListener('submit', function() {
        const btn = document.getElementById('submit-btn');
        const icon = document.getElementById('submit-icon');
        const spinner = document.getElementById('loading-spinner');
        const text = document.getElementById('btn-text');
        
        if (btn) {
          btn.disabled = true;
          btn.classList.add('opacity-75', 'cursor-not-allowed');
          if (icon) icon.classList.add('hidden');
          if (spinner) spinner.classList.remove('hidden');
          if (text) text.innerText = 'Lendo e estruturando com IA...';
        }
      });
    }
  });
</script>
