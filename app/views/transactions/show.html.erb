<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight"><%= @transaction.title %></h1>
      <p class="text-xs text-slate-500 mt-0.5">Detalhes completos do lançamento</p>
    </div>
    <%= link_to "← Voltar", transactions_path, class: "text-xs font-semibold text-slate-500 hover:text-slate-800" %>
  </div>

  <div class="app-card p-6 sm:p-8 space-y-6">
    <!-- Top Highlights Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-100 gap-4">
      <div>
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Valor do Lançamento</span>
        <div class="text-3xl font-extrabold tracking-tight mt-0.5 <%= @transaction.income? ? 'text-emerald-600' : (@transaction.investment? ? 'text-indigo-600' : 'text-rose-600') %>">
          <%= @transaction.income? ? '+' : (@transaction.investment? ? '💎 ' : '-') %><%= @transaction.formatted_amount %>
        </div>
      </div>
      <div>
        <% if @transaction.overdue? %>
          <span class="badge badge-danger text-sm px-3 py-1">Atrasado</span>
        <% elsif @transaction.paid? %>
          <span class="badge badge-success text-sm px-3 py-1">Pago / Liquidado</span>
        <% else %>
          <span class="badge badge-warning text-sm px-3 py-1">Pendente</span>
        <% end %>
      </div>
    </div>

    <!-- Metadata Details Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
      <div class="p-3.5 bg-white rounded-xl border border-slate-100">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Tipo</span>
        <span class="font-bold text-slate-900 text-sm mt-0.5 block">
          <% if @transaction.income? %>
            Entrada (Receita)
          <% elsif @transaction.investment? %>
            Investimento / Aporte Patrimonial
          <% elsif @transaction.transfer? %>
            Transferência entre Contas
          <% else %>
            Saída (Despesa)
          <% end %>
        </span>
      </div>

      <div class="p-3.5 bg-white rounded-xl border border-slate-100">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Conta Bancária</span>
        <span class="font-bold text-slate-900 text-sm mt-0.5 block"><%= @transaction.bank_account.name %></span>
      </div>

      <div class="p-3.5 bg-white rounded-xl border border-slate-100">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Categoria</span>
        <span class="font-bold text-slate-900 text-sm mt-0.5 block"><%= @transaction.category&.name || "Sem categoria" %></span>
      </div>

      <div class="p-3.5 bg-white rounded-xl border border-slate-100">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Forma de Pagamento</span>
        <span class="font-bold text-slate-900 text-sm mt-0.5 block"><%= @transaction.payment_method&.titleize || "Não especificada" %></span>
      </div>

      <div class="p-3.5 bg-white rounded-xl border border-slate-100">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Data de Vencimento</span>
        <span class="font-bold text-slate-900 text-sm mt-0.5 block"><%= @transaction.due_date.strftime("%d/%m/%Y") %></span>
      </div>

      <% if @transaction.paid_at %>
        <div class="p-3.5 bg-white rounded-xl border border-slate-100">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Data da Liquidação</span>
          <span class="font-bold text-emerald-700 text-sm mt-0.5 block"><%= @transaction.paid_at.strftime("%d/%m/%Y") %></span>
        </div>
      <% end %>
    </div>

    <% if @transaction.notes.present? %>
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Notas & Observações</span>
        <div class="text-xs text-slate-700 leading-relaxed"><%= simple_format(@transaction.notes) %></div>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-slate-100">
      <%= link_to "Editar", edit_transaction_path(@transaction), class: "btn-secondary btn-md text-xs" %>
      <% if !@transaction.paid? %>
        <%= link_to "Marcar como Pago", mark_paid_transaction_path(@transaction), method: :patch, data: { turbo_method: :patch }, class: "btn-success btn-md text-xs font-bold" %>
      <% end %>
      <%= link_to "Excluir", @transaction, data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja apagar esta movimentação?" }, class: "btn-danger btn-md text-xs" %>
      <%= link_to "Voltar para Movimentações", transactions_path, class: "btn-secondary btn-md text-xs ml-auto" %>
    </div>
  </div>
</div>
