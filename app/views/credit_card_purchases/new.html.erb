<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Registrar Compra no Cartão</h1>
      <p class="text-xs text-slate-500 mt-0.5">Lançamento no cartão <%= @credit_card.name %></p>
    </div>
    <%= link_to "← Voltar", credit_card_path(@credit_card), class: "text-xs font-semibold text-slate-500 hover:text-slate-800" %>
  </div>

  <div class="app-card p-6 sm:p-8">
    <%= form_with model: @purchase, local: true, url: credit_card_purchases_path(@credit_card), class: "space-y-6" do |f| %>
      <% if @purchase.errors.any? %>
        <div class="rounded-2xl bg-rose-50 border border-rose-200/80 p-4">
          <h3 class="text-xs font-bold text-rose-800 uppercase tracking-wider"><%= pluralize(@purchase.errors.count, "erro") %> encontrado(s):</h3>
          <ul class="mt-2 list-disc list-inside text-xs text-rose-700 space-y-0.5">
            <% @purchase.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :title, "Descrição da Compra", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :title, placeholder: "Ex: TV Samsung, Restaurante, Combustível...", required: true, class: "form-input-custom" %>
        </div>

        <div>
          <%= f.label :category_id, "Categoria", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.select :category_id, @categories.map { |c| [c.full_name, c.id] }, { prompt: "Selecione uma categoria" }, class: "form-select-custom" %>
        </div>

        <div>
          <%= f.label :purchased_at, "Data da Compra", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.date_field :purchased_at, required: true, class: "form-input-custom" %>
        </div>

        <div>
          <%= f.label :total_amount, "Valor Total (R$)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :total_amount, step: 0.01, placeholder: "0,00", required: true, class: "form-input-custom font-semibold text-slate-900" %>
        </div>

        <div>
          <%= f.label :installments, "Número de Parcelas", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.number_field :installments, min: 1, value: 1, class: "form-input-custom" %>
        </div>
      </div>

      <div>
        <%= f.label :notes, "Notas (opcional)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" %>
        <%= f.text_area :notes, rows: 3, placeholder: "Detalhes sobre a compra...", class: "form-input-custom" %>
      </div>

      <div class="flex items-center gap-3 pt-3 border-t border-slate-100">
        <%= f.submit "Registrar Compra", class: "btn-primary btn-md text-xs" %>
        <%= link_to "Cancelar", credit_card_path(@credit_card), class: "btn-secondary btn-md text-xs" %>
      </div>
    <% end %>
  </div>
</div>
